"""Estrategia de acción del precio basada en tres velas M1 cerradas.

PUT:
  1. Vela 1 verde fuerte (cuerpo >= 60% de su rango).
  2. Vela 2 roja (reversión).
  3. Vela 3 roja y cierre por debajo del mínimo de la vela 2 (continuidad).
  4. Ejecutar PUT al abrir la vela M1 siguiente.

CALL: patrón inverso: vela 1 roja fuerte, vela 2 verde, vela 3 verde
que cierra por encima del máximo de la vela 2; ejecutar CALL en la siguiente.

No utiliza indicadores. Los valores STOCH_* se conservan por compatibilidad con
bot.py y herramientas de reporte, pero no intervienen en las señales.
"""
from math import isfinite

# Constantes conservadas para compatibilidad con el bot existente.
STOCH_K_PERIOD = 13
STOCH_K_SMOOTH = 3
STOCH_D_PERIOD = 3
STOCH_OVERBOUGHT = 80.0
STOCH_OVERSOLD = 20.0
TIMEFRAME_SECONDS = 60
STRONG_BODY_RATIO = 0.60


def normalize_candles(raw):
    """Normaliza velas de IQ Option y descarta registros inválidos."""
    out = []
    for candle in raw or []:
        try:
            ts = int(candle.get("from", candle.get("at", candle.get("timestamp", 0))))
            op = float(candle["open"])
            close = float(candle["close"])
            low = float(candle.get("min", candle.get("low", min(op, close))))
            high = float(candle.get("max", candle.get("high", max(op, close))))
            if ts <= 0 or not all(isfinite(x) for x in (op, close, low, high)):
                continue
            if low > min(op, close) or high < max(op, close) or low > high:
                continue
            rng = high - low
            body = abs(close - op)
            out.append({
                "timestamp": ts, "open": op, "close": close,
                "min": low, "max": high, "low": low, "high": high,
                "range": rng, "body": body,
                "body_ratio": body / rng if rng > 0 else 0.0,
                "lower_wick": min(op, close) - low,
                "upper_wick": high - max(op, close),
                "color": "green" if close > op else "red" if close < op else "doji",
            })
        except (KeyError, TypeError, ValueError, OverflowError, AttributeError):
            continue
    unique = {c["timestamp"]: c for c in sorted(out, key=lambda x: x["timestamp"])}
    return list(unique.values())


def analyze_market(raw, current_timestamp=None):
    """Evalúa solo las últimas tres velas cerradas y prepara entrada en la siguiente."""
    candles = normalize_candles(raw)
    result = {
        "signal": "NO SIGNAL", "bias": "NEUTRAL", "call_score": 0, "put_score": 0,
        "sequence": [], "sequence_text": "", "entry_timing": "NEXT_M1_CANDLE",
        "signal_candle_timestamp": None, "confirmation_candle_timestamp": None,
        "entry_candle_timestamp": None, "stoch_k": None, "stoch_d": None,
        "stoch_k_previous": None, "stoch_d_previous": None,
        "reason": "Se necesitan tres velas M1 cerradas para evaluar el patrón.",
        "first_candle": None, "reversal_candle": None, "continuation_candle": None,
    }
    if len(candles) < 3:
        result["reason"] = f"Historial insuficiente: {len(candles)}/3 velas cerradas."
        return result

    first, reversal, continuation = candles[-3:]
    result.update({
        "sequence": [first["color"], reversal["color"], continuation["color"]],
        "sequence_text": "-".join({"green": "V", "red": "R", "doji": "D"}[c["color"]]
                                  for c in (first, reversal, continuation)),
        "signal_candle_timestamp": reversal["timestamp"],
        "confirmation_candle_timestamp": continuation["timestamp"],
        "entry_candle_timestamp": int(current_timestamp) if current_timestamp is not None
                                  else continuation["timestamp"] + TIMEFRAME_SECONDS,
        "first_candle": first, "reversal_candle": reversal,
        "continuation_candle": continuation,
    })

    strong_first = first["range"] > 0 and first["body_ratio"] >= STRONG_BODY_RATIO
    # La continuidad no puede invalidar/superar el extremo contrario de la
    # vela de fuerza: PUT no supera su máximo; CALL no perfora su mínimo.
    put_pattern = (
        strong_first and first["color"] == "green"
        and reversal["color"] == "red" and continuation["color"] == "red"
        and continuation["close"] < reversal["low"]
        and continuation["high"] <= first["high"]
    )
    call_pattern = (
        strong_first and first["color"] == "red"
        and reversal["color"] == "green" and continuation["color"] == "green"
        and continuation["close"] > reversal["high"]
        and continuation["low"] >= first["low"]
    )

    if put_pattern:
        result.update({
            "signal": "PUT", "bias": "PUT", "put_score": 1,
            "reason": (
                f"PUT: vela 1 verde fuerte (cuerpo/rango={first['body_ratio']:.0%}); "
                f"vela 2 roja; vela 3 roja cierra {continuation['close']} por debajo "
                f"del mínimo de vela 2 ({reversal['low']}) y no supera el máximo "
                f"de la vela de fuerza ({first['high']}). Entrada en la siguiente M1."
            ),
        })
    elif call_pattern:
        result.update({
            "signal": "CALL", "bias": "CALL", "call_score": 1,
            "reason": (
                f"CALL: vela 1 roja fuerte (cuerpo/rango={first['body_ratio']:.0%}); "
                f"vela 2 verde; vela 3 verde cierra {continuation['close']} por encima "
                f"del máximo de vela 2 ({reversal['high']}). Entrada en la siguiente M1."
            ),
        })
    else:
        result["reason"] = (
            f"Sin señal: se requieren 3 velas cerradas; vela 1 fuerte >= "
            f"{STRONG_BODY_RATIO:.0%} del rango; PUT=verde fuerte-roja-roja con "
            f"cierre 3 bajo mínimo 2 y máximo 3 <= máximo vela 1; "
            f"CALL=roja fuerte-verde-verde con cierre 3 sobre máximo 2 y "
            f"mínimo 3 >= mínimo vela 1. Secuencia={result['sequence_text']}; "
            f"cuerpo/rango vela 1={first['body_ratio']:.0%}."
        )
    return result
